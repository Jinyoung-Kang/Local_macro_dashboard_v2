# =============================================================================
# .env.example — docker compose가 읽는 값들.
# 실제 값을 넣은 .env는 커밋하지 마세요(.gitignore에 있습니다).
#
# ⚠️ 키가 없어도 앱은 정상 실행됩니다. 키가 없는 기능만 비활성화됩니다.
# =============================================================================

# ---- 화면 접속 ----
APP_PASSWORD=admin1234@
# 세션 서명 키 (32바이트 이상 무작위 값으로 바꾸세요)
JWT_SECRET=change-me-please-change-me-please-32b

# ---- 읽기 모드: auto | store_only | live_only ----
#   auto       저장본이 신선하면 사용, 오래되면 수집기에 수집 요청 (기본)
#   store_only 저장본만 사용. 화면이 외부를 절대 기다리지 않음
#   live_only  항상 수집 요청 (디버깅용)
DASHBOARD_READ_MODE=auto

# ---- 수집 주기(초) ----
COLLECTOR_SCHEDULER=true
COLLECTOR_FAST_INTERVAL=300
COLLECTOR_SLOW_INTERVAL=3600
COLLECTOR_WEEKLY_INTERVAL=43200
# 백엔드→수집기 호출 토큰(선택). 설정하면 양쪽 값이 같아야 합니다.
COLLECTOR_API_TOKEN=

# ---- 외부 데이터 API ----
# FRED  https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=
# KRX   http://data.krx.co.kr
KRX_API_KEY=
# KRX 홈페이지 계정 (선택) — pykrx가 로그인 조회를 시도할 때만 씁니다.
#   비워 두면 pykrx를 비로그인으로 쓰고, KRX가 막으면 수급 레이더의 pykrx
#   단계만 건너뜁니다(KIS·Daum·Naver·누적 이력으로 대체).
KRX_ID=
KRX_PW=
# 한국투자증권  https://apiportal.koreainvestment.com
KIS_APP_KEY=
KIS_APP_SECRET=
# LS증권 (선택) — "Open API"로 사용등록해야 합니다(모의투자 키는 서버가 다릅니다)
LS_APP_KEY=
LS_APP_SECRET=
# 토스증권 (선택, 연결 테스트 메뉴 전용)
TOSS_CLIENT_ID=
TOSS_CLIENT_SECRET=
# SEC EDGAR (13F 메뉴) — 키가 아니라 "연락처"입니다. ⚠️ 13F에는 필수입니다.
#   SEC는 연락처 없는 요청을 정책상 403으로 막습니다. 본인 이메일을 넣으세요.
#   비워 두면 13F 수집만 멈춥니다(나머지 메뉴는 정상 동작).
#   구버전 .streamlit/secrets.toml의 [sec] user_agent 와 같은 값입니다.
#   예) SEC_USER_AGENT=hong@example.com
SEC_USER_AGENT=

# ---- AI 엔진 (선택) ----
# 추론형 모델(gpt-oss, DeepSeek-R1 등)은 응답까지 몇 분이 걸릴 수 있습니다.
# "N초 안에 응답하지 않았습니다"가 뜨면 이 값을 늘리거나 '⚡ 자동 탐색'을 쓰세요.
AI_TIMEOUT_SECONDS=240
NVIDIA_API_KEY=
CEREBRAS_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# ---- 인프라 ----
DATABASE_USER=macro
DATABASE_PASSWORD=macro
DATABASE_NAME=macrodash
DATABASE_PORT=5432
REDIS_PORT=6379
BACKEND_PORT=8080
COLLECTOR_PORT=8000
FRONTEND_PORT=3000
FRONTEND_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_BASE=http://localhost:8080
